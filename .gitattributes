# Normaliza quebras de linha (evita diffs falsos entre Windows e Linux)
* text=auto eol=lf

# Scripts do Windows precisam de CRLF
*.ps1 text eol=crlf
*.bat text eol=crlf

# Binários: nunca tentar fazer diff ou converter
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.svg text
*.ogg binary
*.wav binary
*.mp3 binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.zip binary
*.res binary
